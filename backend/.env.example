# ---------- Server ----------
PORT=4000
# Where the dashboard runs (used for CORS + post-login redirects)
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Run the BullMQ worker inside the API process too (handy for local dev).
# For the "real" setup run `npm run dev:worker` separately and set this to false.
RUN_WORKER_IN_PROCESS=false

# ---------- Infra ----------
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
# Leave empty to disable Elasticsearch (search falls back to Postgres ILIKE)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Goes through the Next.js proxy so the session cookie lands on the dashboard origin
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------- Slack OAuth ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS redirect URLs: use an ngrok / cloudflared tunnel to port 3000 or 4000
SLACK_REDIRECT_URI=https://YOUR-TUNNEL.ngrok-free.app/api/slack/callback

# ---------- Ethereal senders ----------
# Comma-separated "user:pass" pairs from https://ethereal.email/create
# If empty, N accounts are auto-created on first boot and persisted in Postgres.
ETHEREAL_SENDERS=
ETHEREAL_AUTO_CREATE_SENDERS=2

# ---------- Throughput / rate limiting ----------
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender mailbox (Redis-backed, shared across workers)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender per clock hour (Redis counters keyed by sender + hour window)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_SEND_ATTEMPTS=3
# How long a row may stay in "sending" before another worker may reclaim it (crash recovery)
SENDING_LEASE_MS=600000
# Throttle waits shorter than this are slept in-process; longer waits re-delay the job
MAX_INLINE_THROTTLE_WAIT_MS=10000
